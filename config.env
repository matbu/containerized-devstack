# ---------------------------------------------------------------------------
# containerized-devstack configuration
#
# A containerized DevStack whose control plane AND libvirt run inside a podman
# container. VMs run on the HOST's KVM (hardware acceleration via /dev/kvm) and
# their disks live on the host. DevStack keeps its own OVN networking inside the
# container's own network namespace, so it stays isolated from the host.
#
# Sourced by run.sh / Makefile / scripts.
# ---------------------------------------------------------------------------

# --- Target host (must run podman + expose /dev/kvm; this is the hypervisor) -
# Remote over ssh: LAB_HOST=user@host. Local (this machine / already logged into
# the server): LAB_HOST=local (or localhost, or export PDS_LOCAL=1).
LAB_HOST="${LAB_HOST:-root@your-host}"

# --- Base image -------------------------------------------------------------
# ubuntu   : DevStack's primary platform; use where apt mirrors are reachable.
# centos9  : CentOS Stream 9 + RDO Epoxy; use where Ubuntu mirrors are blocked
#            but CentOS/RDO/PyPI are reachable (e.g. the OCP/KubeVirt network).
BASE="${BASE:-ubuntu}"

if [ "$BASE" = "centos9" ]; then
    CONTAINERFILE="${CONTAINERFILE:-Containerfile.centos9}"
    DEVSTACK_BRANCH="${DEVSTACK_BRANCH:-stable/2025.1}"   # Epoxy (RDO on el9)
    IMAGE="${IMAGE:-devstack:centos9-2025.1}"
    REGISTRY_TAG="${REGISTRY_TAG:-centos9-2025.1}"
else
    CONTAINERFILE="${CONTAINERFILE:-Containerfile}"
    DEVSTACK_BRANCH="${DEVSTACK_BRANCH:-stable/2026.2}"
    IMAGE="${IMAGE:-devstack:2026.2}"
    REGISTRY_TAG="${REGISTRY_TAG:-2026.2}"
fi

CONTAINER="${CONTAINER:-devstack}"
# Registry target for `./run.sh push` (published image). Pushes :<tag> + :latest.
REGISTRY_IMAGE="${REGISTRY_IMAGE:-quay.io/os-migrate/devstack}"

# --- On-host layout ----------------------------------------------------------
REMOTE_DIR="${REMOTE_DIR:-/home/containerized-devstack}"        # project files copied here
# Host directory that holds ALL persistent DevStack data (venv, nova instance
# disks, glance images, cinder, logs, mysql...). It is bind-mounted INTO the
# container at DevStack's native data path /opt/stack/data, so every DevStack
# path assumption holds AND the bytes physically live on the host.
# (A SIBLING of REMOTE_DIR so `rsync --delete` on sync never wipes it.)
HOST_DATA_DIR="${HOST_DATA_DIR:-/home/containerized-devstack-data}"
CONTAINER_DATA_DIR="/opt/stack/data"                     # fixed: DevStack default

# --- Container networking (dedicated podman network, isolated from host) -----
PDS_NET="${PDS_NET:-devstack-net}"
PDS_SUBNET="${PDS_SUBNET:-172.31.0.0/24}"
PDS_GW="${PDS_GW:-172.31.0.1}"            # host side of the podman bridge
CONTAINER_IP="${CONTAINER_IP:-172.31.0.10}"  # fixed IP; APIs/Horizon bind here

# --- OpenStack public/floating + tenant ranges ------------------------------
# Pick ranges that don't overlap your host's existing networks. Floating IPs are
# reachable from the host via a route added through CONTAINER_IP (see run.sh).
FLOATING_RANGE="${FLOATING_RANGE:-172.40.0.0/24}"
FLOATING_GW="${FLOATING_GW:-172.40.0.1}"
FLOATING_POOL_START="${FLOATING_POOL_START:-172.40.0.100}"
FLOATING_POOL_END="${FLOATING_POOL_END:-172.40.0.200}"
FIXED_RANGE="${FIXED_RANGE:-10.11.0.0/24}"   # tenant overlay, internal to container

# --- Ports -------------------------------------------------------------------
HORIZON_PORT="${HORIZON_PORT:-80}"   # inside the container netns; no host clash

# --- Credentials -------------------------------------------------------------
ADMIN_PASSWORD="${ADMIN_PASSWORD:-secretadmin}"
